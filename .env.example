# PostgreSQL
POSTGRES_DB=supermarket
POSTGRES_USER=marketfastroute
POSTGRES_PASSWORD=marketfastroute
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1

# Applications
API_PORT=8080
API_BIND_ADDRESS=127.0.0.1
WEB_PORT=5173
WEB_BIND_ADDRESS=127.0.0.1
VITE_API_URL=/api
# Para acessar pela rede privada, inclua a origem exata http://<IP-DO-HOST>:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
