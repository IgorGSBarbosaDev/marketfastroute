{
  "name": "marketfastroute",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "web:dev": "pnpm --filter @marketfastroute/web dev",
    "web:build": "pnpm --filter @marketfastroute/web build",
    "web:test": "pnpm --filter @marketfastroute/web test",
    "web:lint": "pnpm --filter @marketfastroute/web lint",
    "compose:config": "docker compose --env-file .env -f infra/compose.yaml config",
    "compose:up": "docker compose --env-file .env -f infra/compose.yaml up --build",
    "compose:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "demo:seed": "docker compose --env-file .env -f infra/compose.yaml --profile demo run --rm demo-seed",
    "demo:clear": "docker compose --env-file .env -f infra/compose.yaml --profile demo run --rm demo-clear"
  }
}
